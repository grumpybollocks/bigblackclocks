# Compiled binaries -- regenerate with rebuild.sh
g510_lcd_stats
g510_lcd_buttons
__pycache__/
*.pyc

# Commercially-licensed font (Eurostile Bold) and its derived bitmap --
# not ours to redistribute. See README "FONTS" section to reconvert
# your own copy.
fonts/source-ttf/*.otf
fonts/source-ttf/*.ttf
fonts/*.fnt

# Generated at runtime, not part of the project itself
custom_screen_images/*.bin

# G910 runtime state -- now lives under ~/.local/share/g910-control/
# (XDG data dir), these repo-root copies were only ever git-clone-era
# leftovers and are no longer read/written by the app.
g910_profiles.json
g910_macros.json

# Claude Code's own worktree bookkeeping -- not project content
.claude/
